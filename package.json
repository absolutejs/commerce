{
  "name": "@absolutejs/commerce",
  "version": "0.40.1-beta.22",
  "description": "Provider-agnostic commerce primitives (cart, orders, fulfillment, shipping) for AbsoluteJS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/commerce.git"
  },
  "homepage": "https://github.com/absolutejs/commerce",
  "bugs": {
    "url": "https://github.com/absolutejs/commerce/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "browser": "./dist/client/index.js",
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./react": {
      "browser": "./dist/react/index.js",
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./decoration-react": {
      "browser": "./dist/decoration-react/index.js",
      "import": "./dist/decoration-react/index.js",
      "types": "./dist/decoration-react/index.d.ts"
    },
    "./decoration-preview-react": {
      "browser": "./dist/decoration-preview-react/index.js",
      "import": "./dist/decoration-preview-react/index.js",
      "types": "./dist/decoration-preview-react/index.d.ts"
    },
    "./drizzle": {
      "import": "./dist/drizzle/index.js",
      "types": "./dist/drizzle/index.d.ts",
      "default": "./dist/drizzle/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "license": "BSL-1.1",
  "author": "Alex Kahn",
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/drizzle/index.ts ./src/react/index.tsx ./src/manifest.ts --root ./src --outdir dist --target bun --external @absolutejs/commerce --external '@absolutejs/commerce/*' --external @absolutejs/handoff --external @absolutejs/manifest --external @sinclair/typebox --external drizzle-orm --external 'drizzle-orm/*' --external react --external 'react/*' --external fflate && bun build ./src/client/index.ts --outdir dist/client --target browser --format esm && bun build ./src/decoration-react/index.ts --outdir dist/decoration-react --target browser --format esm --external react --external 'react/*' --external three --external 'three/*' --external @react-three/drei --external '@react-three/drei/*' --external @react-three/fiber --external '@react-three/fiber/*' && bun build ./src/decoration-preview-react/index.tsx --outdir dist/decoration-preview-react --target browser --format esm --external react --external 'react/*' && tsc --emitDeclarationOnly --project tsconfig.json && absolute-manifest emit",
    "format": "prettier --write \"./**/*.{js,ts,json,md}\"",
    "release": "bun run check:package && npm publish --access public --tag beta",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify-package": "absolute-manifest verify-package",
    "check:package": "bun run format && bun run typecheck && bun run test && bun run verify-package && bun run build && bun run verify-package --artifacts"
  },
  "peerDependencies": {
    "drizzle-orm": ">=1.0.0-rc.4 <2",
    "react": ">=18 <20",
    "three": ">=0.185.0 <0.186.0",
    "@react-three/drei": ">=10.7.7 <11",
    "@react-three/fiber": ">=9.6.1 <10"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@types/bun": "1.3.14",
    "@types/react": "^19.0.0",
    "@types/three": "^0.185.0",
    "drizzle-orm": "1.0.0-rc.4",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "three": "0.185.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@absolutejs/handoff": "0.1.0",
    "@absolutejs/manifest": "0.7.2",
    "@sinclair/typebox": "0.34.52",
    "fflate": "0.8.3"
  },
  "absolutejs": {
    "manifestContract": 2,
    "runtimePeers": {
      "@react-three/drei": {
        "artifactImports": [
          "@react-three/drei"
        ],
        "buildExternals": [
          "@react-three/drei",
          "@react-three/drei/*"
        ],
        "optional": true,
        "range": ">=10.7.7 <11",
        "tested": "10.7.7"
      },
      "@react-three/fiber": {
        "artifactImports": [
          "@react-three/fiber"
        ],
        "buildExternals": [
          "@react-three/fiber",
          "@react-three/fiber/*"
        ],
        "optional": true,
        "range": ">=9.6.1 <10",
        "tested": "9.6.1"
      },
      "drizzle-orm": {
        "artifactImports": [
          "drizzle-orm",
          "drizzle-orm/pg-core"
        ],
        "buildExternals": [
          "drizzle-orm",
          "drizzle-orm/*"
        ],
        "optional": true,
        "range": ">=1.0.0-rc.4 <2",
        "tested": "1.0.0-rc.4"
      },
      "react": {
        "artifactImports": [
          "react",
          "react/jsx-dev-runtime"
        ],
        "buildExternals": [
          "react",
          "react/*"
        ],
        "optional": true,
        "range": ">=18 <20",
        "tested": "19.2.8"
      },
      "three": {
        "artifactImports": [
          "three"
        ],
        "buildExternals": [
          "three",
          "three/*"
        ],
        "optional": true,
        "range": ">=0.185.0 <0.186.0",
        "tested": "0.185.1"
      }
    }
  }
}
